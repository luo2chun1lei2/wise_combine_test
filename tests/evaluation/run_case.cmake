if(NOT DEFINED CLI OR NOT DEFINED SOURCE_DIR OR NOT DEFINED CASE_DIR OR NOT DEFINED CLEAN_ADAPTER OR NOT DEFINED MUTANT_ADAPTER OR NOT DEFINED SCENARIO)
  message(FATAL_ERROR "missing evaluation configuration")
endif()
file(MAKE_DIRECTORY "${CASE_DIR}")
execute_process(COMMAND mktemp -d "${CASE_DIR}/run.XXXXXX"
  RESULT_VARIABLE temp_result OUTPUT_VARIABLE work OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT temp_result EQUAL 0)
  message(FATAL_ERROR "cannot create isolated evaluation directory")
endif()
set(failures "")
foreach(repeat RANGE 1 2)
  foreach(kind clean mutant)
    set(adapter "${CLEAN_ADAPTER}")
    set(expected 0)
    if(kind STREQUAL "mutant")
      set(adapter "${MUTANT_ADAPTER}")
      set(expected 4)
    endif()
    set(report_dir "${work}/${kind}-${repeat}")
    execute_process(COMMAND "${CLI}" run "${SOURCE_DIR}/tests/evaluation/q${SCENARIO}.json"
      --adapter "${adapter}" --arg --state --arg "${report_dir}/state"
      --reports "${report_dir}" --run-id result
      RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
    if(NOT result STREQUAL "${expected}")
      string(APPEND failures "Q${SCENARIO} ${kind} repeat ${repeat}: expected ${expected}, got ${result}: ${output} ${error}\n")
    else()
      message(STATUS "Q${SCENARIO} ${kind} repeat ${repeat}: exit=${result}")
    endif()
    execute_process(COMMAND "${CLI}" verify-report "${report_dir}/result-0.json"
      RESULT_VARIABLE verified OUTPUT_VARIABLE verification ERROR_VARIABLE verification_error TIMEOUT 5)
    if(NOT verified STREQUAL "0")
      string(APPEND failures "invalid report: ${verification_error}\n")
    endif()
  endforeach()
endforeach()
file(REMOVE_RECURSE "${work}")
if(NOT failures STREQUAL "")
  message(FATAL_ERROR "${failures}")
endif()

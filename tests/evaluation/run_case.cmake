if(NOT DEFINED CLI OR NOT DEFINED SOURCE_DIR OR NOT DEFINED CASE_DIR OR NOT DEFINED CXX_COMPILER OR NOT DEFINED SCENARIO OR NOT DEFINED MUTANT)
  message(FATAL_ERROR "missing evaluation configuration")
endif()
file(MAKE_DIRECTORY "${CASE_DIR}" "${SOURCE_DIR}/tests/fixtures/bin")
set(clean_adapter "${SOURCE_DIR}/tests/fixtures/bin/adapter_eval_q${SCENARIO}_clean")
set(mutant_adapter "${SOURCE_DIR}/tests/fixtures/bin/adapter_eval_q${SCENARIO}_mutant")
execute_process(COMMAND ${CXX_COMPILER} -std=c++17 -DMUTANT=0 -I${SOURCE_DIR}/tests/evaluation ${SOURCE_DIR}/tests/evaluation/queue_adapter.cpp -o ${clean_adapter} RESULT_VARIABLE clean_compile)
execute_process(COMMAND ${CXX_COMPILER} -std=c++17 -DMUTANT=${MUTANT} -I${SOURCE_DIR}/tests/evaluation ${SOURCE_DIR}/tests/evaluation/queue_adapter.cpp -o ${mutant_adapter} RESULT_VARIABLE mutant_compile)
if(NOT clean_compile EQUAL 0 OR NOT mutant_compile EQUAL 0)
  message(FATAL_ERROR "failed to compile Q${SCENARIO} adapters")
endif()
execute_process(COMMAND "${CLI}" run ${SOURCE_DIR}/tests/evaluation/q${SCENARIO}.json --adapter ${clean_adapter} --arg --state --arg ${CASE_DIR}/clean-state --reports ${CASE_DIR}/clean --run-id q${SCENARIO} RESULT_VARIABLE clean_result)
execute_process(COMMAND "${CLI}" run ${SOURCE_DIR}/tests/evaluation/q${SCENARIO}.json --adapter ${mutant_adapter} --arg --state --arg ${CASE_DIR}/mutant-state --reports ${CASE_DIR}/mutant --run-id q${SCENARIO} RESULT_VARIABLE mutant_result)
if(NOT clean_result EQUAL 0 OR NOT mutant_result EQUAL 4)
  message(FATAL_ERROR "Q${SCENARIO} oracle mismatch: clean=${clean_result}, mutant=${mutant_result}")
endif()
file(REMOVE ${clean_adapter} ${mutant_adapter})

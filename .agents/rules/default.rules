prefix_rule(pattern=["git", "add", "-A"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["git", "push"], decision="allow")
prefix_rule(pattern=["/bin/bash", "-lc", "ssh -T -o StrictHostKeyChecking=accept-new git@github.com 2>&1 | head -20"], decision="allow")
prefix_rule(pattern=["/bin/bash", "-lc", "GIT_SSH_COMMAND=\"ssh -o CheckHostIP=no\" git push origin plan_goal"], decision="allow")
prefix_rule(pattern=["git", "add", "ai/proposal.md"], decision="allow")
prefix_rule(pattern=["/bin/bash", "-lc", "/bin/bash -lc \"GIT_SSH_COMMAND=\\\"ssh -o CheckHostIP=no\\\" git push origin plan_goal\""], decision="allow")
